YM.Vac.Numbers.uniform_loop : ∀ᶠ (s : ℝ) in Filter.atTop,
  s * YM.Vac.Numbers.theta s ^ 2 ≤ YM.Vac.Numbers.P s ^ 2 ∧
    s * YM.Vac.Numbers.theta s ^ 3 ≤ 1 ∧
      s * YM.Vac.Numbers.theta s ^ 4 ≤ 1 ∧ ∀ v ≤ 1, 2 * YM.Vac.Numbers.P s ^ v * YM.Vac.Numbers.theta s ^ 2 ≤ 1
def YM.RG.Calendar.monitor : {G : YM.Gauge} → YM.RG.Calendar G → ℕ → ℝ :=
fun {G} S m => Real.exp (Real.log (Real.log (S.hatBeta m)) ^ 2)
def YM.RG.Calendar.loopCap : {G : YM.Gauge} → YM.RG.Calendar G → ℕ → ℝ :=
fun {G} S m => 2 * S.monitor m ^ S.theta (S.J m)
def YM.RG.Calendar.threshold : {G : YM.Gauge} → YM.RG.Calendar G → ℕ → ℝ :=
fun {G} S m => S.hatCoupling m * S.monitor m
def YM.Next.Rank.Ship.yardSky : {G : YM.Gauge} →
  (C : YM.Family G) → {k N : ℕ} → ℝ → k ≤ N → (p : ℕ) → YM.Cells.Tiling (C.side N p) :=
fun {G} C {k N} b hN p =>
  let A := C.path.levels;
  YM.Cells.center C.S p ⋯ 0
@YM.Next.Rank.Station.FitSky.stencils : ∀ {G : YM.Gauge} {F : YM.Family G} {k n : ℕ} {b : ℝ} {x : YM.Points n},
  YM.Next.Rank.Station.FitSky F.path.levels b k x →
    F.Makes →
      ∀ (d : ℕ),
        ∀ᶠ (N : ℕ) in Filter.atTop,
          ∃ (hN : k ≤ N),
            ∀ (p : ℕ) (i : Fin n) (v : F.label d),
              have a := F.path.levels;
              have T := YM.Cells.center F.S p ⋯ 0;
              YM.Cells.Interior (T.chamber 0)
                (F.O N p v (YM.Cells.location F.S k N p (YM.Next.Rank.Station.choose a b k x i)))
