def YM.Next.Rank.Ship.bank : {G : YM.Gauge} → YM.Next.Rank.HaarBudget G → YM.RG.Levels G → ℕ → Prop :=
fun {G} O A m =>
  ∀ (p : ℕ) (P : YM.RG.Rep G (A.S.side m p)) (g Λ δ X : ℝ) (k : ℕ),
    YM.Next.Rank.Station.Meets A m p P g Λ δ →
      X ≤ 1 + ↑k →
        YM.Next.Rank.protection O P (A.params m).paths Λ δ X g -
            4 * ↑G.lieDim * Real.log g / ↑(Fintype.card (YM.Lattice.Site (A.S.side m p))) ≤
          YM.Next.Rank.Station.ticket O (A.params m) k
def YM.Next.Rank.protection : {G : YM.Gauge} →
  {n : YM.Lattice.Side} → YM.Next.Rank.HaarBudget G → YM.RG.Rep G n → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ :=
fun {G} {n} O R A Λ δ X g =>
  2 * R.exCost A Λ δ + ↑(Fintype.card YM.Lattice.PlaqAxes) + R.beta * YM.RG.baseBudget R.clip A g + X +
      3 * YM.Next.Rank.ent O R.clip -
    4 * Real.log O.small
def YM.Next.Rank.Station.ticket : {G : YM.Gauge} → YM.Next.Rank.HaarBudget G → YM.RG.Stage → ℕ → ℝ :=
fun {G} O s m =>
  2 * (1 + (8 * s.paths + 1)) + ↑(Fintype.card YM.Lattice.PlaqAxes) +
            ↑(Fintype.card YM.Lattice.PlaqAxes) * (s.clip.direct + s.paths ^ 2) / 2 +
          (1 + ↑m) +
        3 * YM.Next.Rank.ent O s.clip -
      4 * Real.log O.small +
    1
def YM.RG.Rep.exCost : {n : YM.Lattice.Side} → {G : YM.Gauge} → YM.RG.Rep G n → ℝ → ℝ → ℝ → ℝ :=
fun {n} {G} R A Λ δ => δ + YM.RG.PathData.loopsPrice R.p R.beta A Λ
def YM.RG.PathData.loopsPrice : YM.RG.BudgetPoint → ℝ → ℝ → ℝ → ℝ :=
fun p β C Λ => β * (C * p.threshold ^ 3 + C * p.threshold ^ 4) + Λ * p.threshold ^ 2
def YM.RG.baseBudget : YM.RG.Clip → ℝ → ℝ → ℝ :=
fun C A s => ↑(Fintype.card YM.Lattice.PlaqAxes) * (C.direct * s ^ 2 / 2 + (A * s) ^ 2 / 2)
def YM.Next.Rank.ent : {G : YM.Gauge} → YM.Next.Rank.HaarBudget G → YM.RG.Clip → ℝ :=
fun {G} O p => Real.log O.big - ↑G.lieDim * Real.log (YM.Next.Rank.strength p)
def YM.Next.Rank.strength : YM.RG.Clip → ℝ :=
fun p => min 1 p.linear
structure YM.Next.Rank.HaarBudget (G : YM.Gauge) : Type
number of parameters: 1
fields:
  YM.Next.Rank.HaarBudget.small : ℝ
  YM.Next.Rank.HaarBudget.big : ℝ
  YM.Next.Rank.HaarBudget.positive : 0 < self.small
  YM.Next.Rank.HaarBudget.small_le : self.small ≤ 1
  YM.Next.Rank.HaarBudget.big_ge : 1 ≤ self.big
  YM.Next.Rank.HaarBudget.low : ∀ (r : ℝ), 0 < r → r ≤ 1 → self.small * r ^ G.lieDim ≤ G.probHaar.real (G.shell (r / 4))
  YM.Next.Rank.HaarBudget.high : ∀ (t : ℝ),
      0 < t → ∫ (u : G.El), Real.exp (-(G.chord u / t)) ∂G.probHaar ≤ self.big * t ^ G.lieDim
constructor:
  YM.Next.Rank.HaarBudget.mk {G : YM.Gauge} (small big : ℝ) (positive : 0 < small) (small_le : small ≤ 1)
    (big_ge : 1 ≤ big) (low : ∀ (r : ℝ), 0 < r → r ≤ 1 → small * r ^ G.lieDim ≤ G.probHaar.real (G.shell (r / 4)))
    (high : ∀ (t : ℝ), 0 < t → ∫ (u : G.El), Real.exp (-(G.chord u / t)) ∂G.probHaar ≤ big * t ^ G.lieDim) :
    YM.Next.Rank.HaarBudget G
structure YM.Next.Rank.Station.Meets {G : YM.Gauge} (A : YM.RG.Levels G) (m p : ℕ) (P : YM.RG.Rep G (A.S.side m p))
  (g Λ δ : ℝ) : Prop
number of parameters: 8
fields:
  YM.Next.Rank.Station.Meets.same : P.clip = (A.params m).clip
  YM.Next.Rank.Station.Meets.cap : P.beta ≤ 4 * A.clock.hatBeta m
  YM.Next.Rank.Station.Meets.assigned : P.beta * g ^ 2 = 1
  YM.Next.Rank.Station.Meets.positive : 0 < g
  YM.Next.Rank.Station.Meets.entrance : g ≤ P.p.threshold
  YM.Next.Rank.Station.Meets.max_threshold : P.p.threshold ≤ A.clock.threshold m
  YM.Next.Rank.Station.Meets.cap_E : δ ≤ 1
  YM.Next.Rank.Station.Meets.loopCap : Λ ≤ A.clock.loopCap m
constructor:
  YM.Next.Rank.Station.Meets.mk {G : YM.Gauge} {A : YM.RG.Levels G} {m p : ℕ} {P : YM.RG.Rep G (A.S.side m p)}
    {g Λ δ : ℝ} (same : P.clip = (A.params m).clip) (cap : P.beta ≤ 4 * A.clock.hatBeta m)
    (assigned : P.beta * g ^ 2 = 1) (positive : 0 < g) (entrance : g ≤ P.p.threshold)
    (max_threshold : P.p.threshold ≤ A.clock.threshold m) (cap_E : δ ≤ 1) (loopCap : Λ ≤ A.clock.loopCap m) :
    YM.Next.Rank.Station.Meets A m p P g Λ δ
