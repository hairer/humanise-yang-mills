  let A := C.path.levels;
  YM.Cells.center C.S p ⋯ 0
def YM.Next.Rank.Ship.invoiceSky : {G : YM.Gauge} →
  {k : ℕ} →
    {C : YM.Family G} →
      {b : ℝ} →
        {n : ℕ} →
          {x : YM.Points n} →
            (Fin n → (YM.Cells.standard C).Tag) →
              (Fin n → C.book.Token) →
                YM.Next.Rank.Station.FitSky C.path.levels b k x →
                  (N p : ℕ) → YM.Wilson.Config G (C.side N p) → YM.Next.Rank.Glyph.veil (Fin n) :=
fun {G} {k} {C} {b} {n} {x} B t hx N p =>
  YM.Next.Rank.Read.cylinder (YM.Next.Rank.Ship.targetsSky C B hx) (YM.Next.Rank.Ship.clients C t b k N p x)
def YM.Next.Rank.Ship.targetsSky : {G : YM.Gauge} →
  {k : ℕ} →
    {b : ℝ} →
      {n : ℕ} →
        {x : YM.Points n} →
          (C : YM.Family G) →
            (Fin n → (YM.Cells.standard C).Tag) →
              YM.Next.Rank.Station.FitSky C.path.levels b k x → YM.Next.Rank.Glyph.veil (Fin n) :=
fun {G} {k} {b} {n} {x} C B hx => YM.Next.Rank.Read.cumulants C (YM.Next.Rank.Station.tested C.path.levels b k x) B ⋯
