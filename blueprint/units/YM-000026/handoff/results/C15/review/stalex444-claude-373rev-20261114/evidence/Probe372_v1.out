@YM.Next.Rank.Ship.fixed : ∀ {G : YM.Gauge} (A : YM.RG.Levels G) (M k : ℕ), 1 ≤ YM.Next.Rank.Ship.allowance A M k
@[reducible] def YM.MergeProof.East.trays : ℕ → ℕ :=
fun d => d + 2
@[reducible] def YM.Next.UVStress.sizeHint : ℕ → ℝ :=
fun k => ↑k + 1
@[reducible] def YM.Next.UVStress.costHint : ℕ → ℝ :=
fun k => (YM.Next.UVStress.sizeHint k)⁻¹
