  YM.Next.Rank.Tapes.Panel.currency : ℝ
  YM.Next.Rank.Tapes.Panel.θ : ℕ
  YM.Next.Rank.Tapes.Panel.enough : d ≤ self.θ
  YM.Next.Rank.Tapes.Panel.factor : ∀ (i : ℕ), (self.bag i).band = self.arc
  YM.Next.Rank.Tapes.Panel.stable : ∀ (i : ℕ), (self.bag i).taylor = self.θ
  YM.Next.Rank.Tapes.Panel.loose : ∀ (i : ℕ), self.arc * ↑d + ↑d + 2 ≤ (self.bag i).credit
  YM.Next.Rank.Tapes.Panel.vital : ∀ (i : ℕ), (self.bag i).f = self.currency
