    (stable : ∀ (i : ℕ), (bag i).taylor = θ) (loose : ∀ (i : ℕ), arc * ↑d + ↑d + 2 ≤ (bag i).credit)
    (vital : ∀ (i : ℕ), (bag i).f = currency) : YM.Next.Rank.Tapes.Panel d
def YM.Next.Rank.Ship.pot : {G : YM.Gauge} → YM.RG.Levels G → ℕ → ℕ → ℝ :=
fun {G} A M k => Real.log (A.clock.monitor k) / (16 * ↑M)
def YM.Next.Rank.Ship.allowance : {G : YM.Gauge} → YM.RG.Levels G → ℕ → ℕ → ℝ :=
fun {G} A M k => Real.exp (2 * YM.Next.Rank.Ship.pot A M k)
def YM.Next.Rank.Ship.budget : {G : YM.Gauge} → YM.RG.Levels G → ℕ → ℕ → ℝ :=
fun {G} A M k => Real.exp (-YM.Next.Rank.Ship.pot A M k)
