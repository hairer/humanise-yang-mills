@YM.Cells.Tiling.fits_stencil : ∀ {n : YM.Lattice.Side} (T : YM.Cells.Tiling n) {x : YM.Lattice.Site n} {v : T.Cell}
  {k : ℕ},
  x ∈ T.margin v k →
    ∀ {z : YM.Lattice.Cover}, (∀ (a : YM.Axis), (z a).natAbs < k) → (YM.Lattice.wrap n) z + x ∈ T.chamber v
