def YM.Cells.Tiling.margin : {n : YM.Lattice.Side} → (T : YM.Cells.Tiling n) → T.Cell → ℕ → Set (YM.Lattice.Site n) :=
fun {n} T v k =>
  {x | x ∈ T.chamber v ∧ ∀ (a : YM.Axis), k ≤ T.coordinated v x a ∧ T.coordinated v x a + k + T.kind.shift ≤ ↑T.side}
def YM.Cells.Tiling.chamber : {n : YM.Lattice.Side} → (T : YM.Cells.Tiling n) → T.Cell → Set (YM.Lattice.Site n) :=
fun {n} T v => {x | ∀ (i : YM.Axis), T.kind.Strict (↑T.side) (ZMod.val (x i - T.starts v i))}
def YM.Cells.Tiling.coordinated : {n : YM.Lattice.Side} →
  (T : YM.Cells.Tiling n) → T.Cell → YM.Lattice.Site n → YM.Axis → ℕ :=
fun {n} T v x a => ZMod.val (x a - T.starts v a)
def YM.Cells.Kind.Strict : YM.Cells.Kind → ℕ → ℕ → Prop :=
fun x x_1 x_2 =>
  match x, x_1, x_2 with
  | YM.Cells.Kind.site, w, r => 0 < r ∧ r < w
  | YM.Cells.Kind.link, w, r => r < w
def YM.Cells.Kind.shift : YM.Cells.Kind → ℕ :=
fun x =>
  match x with
  | YM.Cells.Kind.site => 0
  | YM.Cells.Kind.link => 1
def YM.Cells.center : (S : YM.Schedule) →
  {m N : ℕ} → (p : ℕ) → m ≤ N → YM.Lattice.Site (S.side N p) → YM.Cells.Tiling (S.side N p) :=
fun S {m N} p h o =>
  { period := S.side m p, units := S.toDepth h p, widthHalf := YM.Cells.half S m p, even := ⋯,
    kind := YM.Cells.Kind.link, base := fun i => o i - ↑(↑(S.toDepth h p).count / 2) }
def YM.Cells.location : (S : YM.Schedule) → ℕ → (N p : ℕ) → YM.Lattice.Cover → YM.Lattice.Site (S.side N p) :=
fun S k N p x => if h : k ≤ N then (S.toDepth h p).embed ((YM.Lattice.wrap (S.side k p)) x) else 0
structure YM.Cells.Interior {n : YM.Lattice.Side} {G : YM.Gauge} (K : Set (YM.Lattice.Site n))
  (F : YM.Wilson.Config G n → ℂ) : Prop
number of parameters: 4
fields:
  YM.Cells.Interior.gauge : YM.Lattice.GaugeInvariant F
  YM.Cells.Interior.borel : Measurable F
  YM.Cells.Interior.localSites : YM.Lattice.LocalOn K F
  YM.Cells.Interior.cost : ∃ c, ∀ (U : YM.Wilson.Config G n), ‖F U‖ ≤ c
constructor:
  YM.Cells.Interior.mk {n : YM.Lattice.Side} {G : YM.Gauge} {K : Set (YM.Lattice.Site n)} {F : YM.Wilson.Config G n → ℂ}
    (gauge : YM.Lattice.GaugeInvariant F) (borel : Measurable F) (localSites : YM.Lattice.LocalOn K F)
    (cost : ∃ c, ∀ (U : YM.Wilson.Config G n), ‖F U‖ ≤ c) : YM.Cells.Interior K F
def YM.Source.SectionData.footprint : {G : YM.Gauge} →
  {d : ℕ} →
    {F : YM.Labels.Frame G d} →
      YM.Source.SectionData F → {n : YM.Lattice.Side} → YM.Lattice.Site n → Finset (YM.Lattice.Site n) :=
fun {G} {d} {F} C {n} o => Finset.image (fun x => (YM.Lattice.wrap n) x + o) C.stencil
def YM.Lattice.LocalOn.{u_1, u_2, u_3} : {R : Type u_1} →
  {K : Type u_2} → [AddCommGroup R] → [One R] → {B : Type u_3} → Set (YM.Four R) → (YM.Lattice.Links R K → B) → Prop :=
fun {R} {K} [AddCommGroup R] [One R] {B} X F => ∀ (U V : YM.Lattice.Links R K), YM.Lattice.Agrees X U V → F U = F V
def YM.Lattice.Agrees.{u_1, u_2} : {R : Type u_1} →
  {K : Type u_2} → [AddCommGroup R] → [One R] → Set (YM.Four R) → YM.Lattice.Links R K → YM.Lattice.Links R K → Prop :=
fun {R} {K} [AddCommGroup R] [One R] X U V =>
  ∀ (e : YM.Lattice.Edge (YM.Four R)), e.1 ∈ X → e.1 + YM.Lattice.step e.2 ∈ X → U e = V e
YM.Cells.trueLength : ∀ (S : YM.Schedule) {m N p : ℕ} (h : m ≤ N) (o : YM.Lattice.Site (S.side N p)),
  S.a N * ↑↑(YM.Cells.center S p h o).side = S.a m
@YM.Trace.Verse.seat : ∀ {G : YM.Gauge} {C : YM.Family G} {𝓛 : Ultrafilter (ℕ × ℕ)} {f : YM.Extraction.Order}
  {S : YM.Table C.book} {V : YM.OS.Chamber S YM.timeAxis} {A : YM.OS.Spread V} {p : A.Resolution} {d : ℕ}
  {H : (YM.Cells.standard C).Hierarchy} {J : YM.Climb.Scaling S} {W : (i : ℕ) → YM.MergeProof.East.Vane C i}
  {Y : (d : ℕ) → ℕ → (YM.Cells.standard C).Field d →L[ℂ] C.label d},
  YM.Trace.Terrace.Gondola f H J 𝓛 W Y →
    YM.Spec.Seed C f S →
      ↑𝓛 ≤ f.fuse →
        p.Out →
          YM.OS.Ground.Steady V →
            ∀ {K : p.X → YM.Table C.book},
              (∀ (i : p.X), (K i).Hierarchy) →
                (∀ (i : p.X), p.receives (K i) i) →
                  ∀ (t : Fin 2 → YM.MergeProof.East.PegC C d) (x' : p.X),
                    (K x').respects S →
                      ∀ᶠ (i : ℕ) in Filter.atTop,
                        ∀ (x : YM.Points 2),
                          YM.Next.Rank.Station.FitSky C.path.levels (W i).b (W i).k x →
                            YM.Trace.Verse.fad (W i) x ∈ YM.Climb.Scaling.window 100 2 →
                              have T := fun j => (YM.MergeProof.East.PoleC C d) (t j);
                              have Q := YM.Trace.Verse.fad (W i) x;
                              have m := YM.Next.Rank.Read.maxProfile C Q fun j => ⟨d, T j⟩;
                              ‖((S.classMoment (K x') (fun x => d) (YM.Trace.Verse.rum (W i) x)) fun j =>
                                      (J.U i d) (T j)) -
                                    ((YM.Cells.standard C).classMoment (YM.Cells.standard C) (fun x => d) Q) T‖ ≤
                                YM.Next.UVStress.costHint i +
                                  (‖YM.Marker.Poly.part m (YM.Next.Rank.Glyph.slot 0)‖ +
                                      ‖YM.Marker.Poly.part m (YM.Next.Rank.Glyph.slot 1)‖) *
                                    YM.Next.UVStress.costHint i
