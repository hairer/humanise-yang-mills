def YM.Next.Rank.Station.gainSky : YM.Schedule → ℕ → ℝ → ℕ :=
fun T i r => {j ∈ Finset.range (i + 1) | r ≤ T.a j / T.a i}.sup id
def YM.Next.Rank.Station.middleSky : {G : YM.Gauge} → YM.RG.Levels G → ℝ → ℕ → ℕ :=
fun {G} A b k => YM.Next.Rank.Station.gainSky A.S k (YM.Next.Rank.Station.mag A b k * A.clock.monitor k ^ 2)
def YM.Next.Rank.Station.widthSky : {G : YM.Gauge} → YM.RG.Levels G → ℝ → ℕ → ℕ :=
fun {G} A b k => YM.Next.Rank.Station.gainSky A.S (YM.Next.Rank.Station.middleSky A b k) (↑(A.clock.coverSize k) ^ 10)
def YM.Next.Rank.Station.choose : {G : YM.Gauge} →
  YM.RG.Levels G → ℝ → ℕ → {n : ℕ} → YM.Points n → Fin n → YM.Lattice.Cover :=
fun {G} a b k {n} x => YM.Extraction.address (YM.Next.Rank.Station.mag a b k)⁻¹ x
def YM.Next.Rank.Station.key : {G : YM.Gauge} → YM.RG.Levels G → ℝ → ℕ → {n : ℕ} → YM.Points n → YM.Points n :=
fun {G} a b k {n} x => YM.Extraction.tag (a.S.a k) (YM.Next.Rank.Station.choose a b k x)
def YM.Extraction.address : {n : ℕ} → ℝ → YM.Points n → Fin n → YM.Lattice.Cover :=
fun {n} t x i a => ⌈(x.ofLp i).ofLp a / t⌉
def YM.Extraction.tag : {n : ℕ} → ℝ → (Fin n → YM.Lattice.Cover) → YM.Points n :=
fun {n} t p => YM.points fun i => WithLp.toLp 2 fun a => t * ↑(p i a)
