    C.Makes →
      ↑𝓛 ≤ F.fuse →
        G.Simple →
          YM.Trace.Terrace.PostT C.path.levels →
            Filter.Tendsto (fun i => Z.β i / Z.β (YM.Trace.Terrace.summit C.path.levels i)) Filter.atTop (nhds 1)
@YM.Trace.Terrace.holds : ∀ {G : YM.Gauge} {C : YM.Family G} {F : YM.Extraction.Order} {𝓛 : Ultrafilter (ℕ × ℕ)},
  ↑𝓛 ≤ F.fuse →
    C.Makes →
      ∀ {Z : YM.Trace.Terrace.Arch C},
        YM.Trace.Terrace.steep 𝓛 Z →
          ∀ (k : ℕ), C.path.levels.clock.hatBeta k / 2 ≤ Z.β k ∧ Z.β k ≤ 2 * C.path.levels.clock.hatBeta k
@YM.Trace.Terrace.dex : ∀ {G : YM.Gauge} {C : YM.Family G} {F : YM.Extraction.Order} {𝓛 : Ultrafilter (ℕ × ℕ)},
  ↑𝓛 ≤ F.fuse →
    C.Makes →
      ∀ {Z : YM.Trace.Terrace.Arch C}, YM.Trace.Terrace.steep 𝓛 Z → ∀ (k : ℕ), Z.β k ≤ 2 * C.path.levels.clock.hatBeta k
@YM.Trace.Terrace.measured : ∀ {G : YM.Gauge} {C : YM.Family G} {F : YM.Extraction.Order} {𝓛 : Ultrafilter (ℕ × ℕ)},
  ↑𝓛 ≤ F.fuse → C.Makes → ∀ {Z : YM.Trace.Terrace.Arch C}, YM.Trace.Terrace.steep 𝓛 Z → ∀ (k : ℕ), 0 < Z.β k
