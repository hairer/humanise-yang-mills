                          ∀ {Z : YM.Trace.Terrace.Arch C},
                            YM.Trace.Terrace.steep 𝓛 Z →
                              ∀ {L : YM.Trace.Slate.PaceBook C},
                                YM.Trace.Slate.Rod t none (↑𝓛) L →
                                  ∀ {S : YM.Table C.book} {J : YM.Climb.Scaling S} {H : (YM.Cells.standard C).Hierarchy}
                                    {V : (i : ℕ) → YM.MergeProof.East.Vane C i}
