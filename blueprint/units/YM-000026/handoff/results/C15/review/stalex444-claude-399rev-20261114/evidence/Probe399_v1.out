                                        ∀ (H' : S.Hierarchy),
                                          F.PointLimits C S →
                                            YM.MergeProof.East.StarPath F H J H' 𝓛 →
                                              ∀ {P₁ : YM.DiffPlan (YM.Cells.standard C)},
                                                P₁.Derivatives (YM.Cells.standard C) →
                                                  P₁.Orientation ⋯ →
                                                    ∀ {X₁ : YM.Spec.Algebra S},
                                                      YM.Spec.Locals X₁ ⋯ →
                                                        YM.Trace.Over.Marvel (YM.Climb.Bel C.book) ⋯
                                                            (YM.Trace.Shelves.materialB C none) P₁ →
                                                          YM.Cells.CellHyp C F → YM.Trace.Over.Scribe F J V Z X₁ 𝓛 H' H
