@[reducible] def YM.Trace.Over.BQ : {G : YM.Gauge} →
  {C : YM.Family G} → YM.Trace.Terrace.Arch C → ((i : ℕ) → YM.MergeProof.East.Vane C i) → ℕ → ℝ :=
fun {G} {C} Z V => Z.β ∘ YM.Trace.Terrace.Stern V
@[reducible] def YM.Trace.Over.ZoomValue : {G : YM.Gauge} →
  {C : YM.Family G} →
    {S : YM.Table C.book} → YM.Climb.Scaling S → (ℕ → ℝ) → S.Field 4 → ℕ → (YM.Spin.comparator C.book).Field 4 :=
fun {G} {C} {S} X B v k => (LinearEquiv.symm (X.U k 4)) ((B k * X.r k ^ 4) • v)
@[reducible] def YM.Trace.Over.LogZoom : {G : YM.Gauge} →
  {C : YM.Family G} → {S : YM.Table C.book} → YM.Climb.Scaling S → ℕ → ℝ :=
fun {G} {C} {S} X i => Real.log (X.r i)⁻¹
def YM.Trace.Over.Year : {G : YM.Gauge} →
  {C : YM.Family G} → {S : YM.Table C.book} → YM.Climb.Scaling S → ℕ → S.Stress →ₗ[ℝ] (YM.Cells.standard C).Stress :=
fun {G} {C} {S} J k => J.r k ^ 4 • YM.Next.UVStress.transformed (LinearEquiv.symm (J.U k 4))
structure YM.Trace.Over.Scribe {G : YM.Gauge} {C : YM.Family G} {S : YM.Table C.book} (Q : YM.Extraction.Order)
  (J : YM.Climb.Scaling S) (V : (i : ℕ) → YM.MergeProof.East.Vane C i) (Z : YM.Trace.Terrace.Arch C)
  (A' : YM.Spec.Algebra S) (𝓛 : Ultrafilter (ℕ × ℕ)) (H' : S.Hierarchy) (H : (YM.Climb.Bel C.book).Hierarchy) : Prop
number of parameters: 11
fields:
  YM.Trace.Over.Scribe.grows : Filter.Tendsto (YM.Trace.Over.BQ Z V) Filter.atTop Filter.atTop
  YM.Trace.Over.Scribe.clock : Filter.Tendsto (fun i => YM.Trace.Over.LogZoom J i / YM.Trace.Over.BQ Z V i) Filter.atTop
      (nhds G.slopeConstant⁻¹)
  YM.Trace.Over.Scribe.meters : ∃ Y, YM.Trace.Terrace.Gondola Q H J 𝓛 V Y
  YM.Trace.Over.Scribe.monorail : YM.MergeProof.East.StarPath Q H J H' 𝓛
  YM.Trace.Over.Scribe.gallery : ∀ (T : YM.Table C.book),
      T.Hierarchy →
        T.respects S →
          ∃ d e,
            (∀ᶠ (i : ℕ) in Filter.atTop,
                (LinearEquiv.symm (J.U i 4)) (J.r i ^ 4 • YM.TraceExtension.theta T A'.energy) =
                  (YM.Trace.Over.ScalarP C) ![e i, d i]) ∧
              Filter.Tendsto (fun i => YM.Trace.Over.BQ Z V i * d i) Filter.atTop (nhds (YM.Trace.Over.d2 G)) ∧
                Filter.Tendsto (fun i => YM.Trace.Over.BQ Z V i * e i) Filter.atTop (nhds 0)
  YM.Trace.Over.Scribe.main : Filter.Tendsto
      (fun k => (YM.Trace.Over.Year J k) ((YM.Next.UVStress.reCenter S) A'.energy)) Filter.atTop
      (nhds (YM.Trace.Shelves.materialB C none))
  YM.Trace.Over.Scribe.goal : ∀ (T : YM.Table C.book),
      Filter.Tendsto (YM.Trace.Over.ZoomValue J (YM.Trace.Over.BQ Z V) (YM.TraceExtension.theta T A'.energy))
        Filter.atTop (nhds ((4 * YM.Trace.Over.d2 G) • YM.Trace.Over.OScale C.book))
constructor:
  YM.Trace.Over.Scribe.mk {G : YM.Gauge} {C : YM.Family G} {S : YM.Table C.book} {Q : YM.Extraction.Order}
    {J : YM.Climb.Scaling S} {V : (i : ℕ) → YM.MergeProof.East.Vane C i} {Z : YM.Trace.Terrace.Arch C}
    {A' : YM.Spec.Algebra S} {𝓛 : Ultrafilter (ℕ × ℕ)} {H' : S.Hierarchy} {H : (YM.Climb.Bel C.book).Hierarchy}
    (grows : Filter.Tendsto (YM.Trace.Over.BQ Z V) Filter.atTop Filter.atTop)
    (clock :
      Filter.Tendsto (fun i => YM.Trace.Over.LogZoom J i / YM.Trace.Over.BQ Z V i) Filter.atTop
        (nhds G.slopeConstant⁻¹))
    (meters : ∃ Y, YM.Trace.Terrace.Gondola Q H J 𝓛 V Y) (monorail : YM.MergeProof.East.StarPath Q H J H' 𝓛)
    (gallery :
      ∀ (T : YM.Table C.book),
        T.Hierarchy →
          T.respects S →
            ∃ d e,
              (∀ᶠ (i : ℕ) in Filter.atTop,
                  (LinearEquiv.symm (J.U i 4)) (J.r i ^ 4 • YM.TraceExtension.theta T A'.energy) =
                    (YM.Trace.Over.ScalarP C) ![e i, d i]) ∧
                Filter.Tendsto (fun i => YM.Trace.Over.BQ Z V i * d i) Filter.atTop (nhds (YM.Trace.Over.d2 G)) ∧
                  Filter.Tendsto (fun i => YM.Trace.Over.BQ Z V i * e i) Filter.atTop (nhds 0))
    (main :
      Filter.Tendsto (fun k => (YM.Trace.Over.Year J k) ((YM.Next.UVStress.reCenter S) A'.energy)) Filter.atTop
        (nhds (YM.Trace.Shelves.materialB C none)))
    (goal :
      ∀ (T : YM.Table C.book),
        Filter.Tendsto (YM.Trace.Over.ZoomValue J (YM.Trace.Over.BQ Z V) (YM.TraceExtension.theta T A'.energy))
          Filter.atTop (nhds ((4 * YM.Trace.Over.d2 G) • YM.Trace.Over.OScale C.book))) :
    YM.Trace.Over.Scribe Q J V Z A' 𝓛 H' H
