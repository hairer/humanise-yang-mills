@YM.Trace.Over.Scribe.goal : ∀ {G : YM.Gauge} {C : YM.Family G} {S : YM.Table C.book} {Q : YM.Extraction.Order}
  {J : YM.Climb.Scaling S} {V : (i : ℕ) → YM.MergeProof.East.Vane C i} {Z : YM.Trace.Terrace.Arch C}
  {A' : YM.Spec.Algebra S} {𝓛 : Ultrafilter (ℕ × ℕ)} {H' : S.Hierarchy} {H : (YM.Climb.Bel C.book).Hierarchy},
  YM.Trace.Over.Scribe Q J V Z A' 𝓛 H' H →
    ∀ (T : YM.Table C.book),
      Filter.Tendsto (YM.Trace.Over.ZoomValue J (YM.Trace.Over.BQ Z V) (YM.TraceExtension.theta T A'.energy))
        Filter.atTop (nhds ((4 * YM.Trace.Over.d2 G) • YM.Trace.Over.OScale C.book))
@YM.Trace.Over.Scribe.clock : ∀ {G : YM.Gauge} {C : YM.Family G} {S : YM.Table C.book} {Q : YM.Extraction.Order}
  {J : YM.Climb.Scaling S} {V : (i : ℕ) → YM.MergeProof.East.Vane C i} {Z : YM.Trace.Terrace.Arch C}
  {A' : YM.Spec.Algebra S} {𝓛 : Ultrafilter (ℕ × ℕ)} {H' : S.Hierarchy} {H : (YM.Climb.Bel C.book).Hierarchy},
  YM.Trace.Over.Scribe Q J V Z A' 𝓛 H' H →
