  YM.Trace.Over.Scribe Q J V Z A' 𝓛 H' H → ∃ Y, YM.Trace.Terrace.Gondola Q H J 𝓛 V Y
def YM.RG.Calendar.hatBeta : {G : YM.Gauge} → YM.RG.Calendar G → ℕ → ℝ :=
fun {G} S m => S.bar + G.slopeConstant * S.schedule.scale m
structure YM.RG.Levels (G : YM.Gauge) : Type
number of parameters: 1
fields:
  YM.RG.Levels.clock : YM.RG.Calendar G
