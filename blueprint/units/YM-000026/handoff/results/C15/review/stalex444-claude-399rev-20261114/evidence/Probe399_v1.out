                                                              ∀ {Δ Ω : YM.Trace.Slate.PaceBook C},
                                                                YM.Trace.Slate.Rod t (some true) (↑𝓛) Δ →
                                                                  YM.Trace.Slate.Rod t (some false) (↑𝓛) Ω →
