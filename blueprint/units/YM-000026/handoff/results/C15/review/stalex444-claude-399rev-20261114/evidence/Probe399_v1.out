                                                                            ‖c i‖ ≤ I * YM.Trace.Over.RQ V i ∧ ⋯ = ⋯) →
                                                                          Filter.Tendsto
                                                                              (YM.Trace.Terrace.Moment4 Z J V)
                                                                              Filter.atTop
                                                                              (nhds (YM.Trace.Terrace.Hill4 C)) →
