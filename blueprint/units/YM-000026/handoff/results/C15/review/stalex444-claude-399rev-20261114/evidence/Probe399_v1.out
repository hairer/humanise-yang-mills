def YM.Trace.Terrace.Stern : {G : YM.Gauge} → {C : YM.Family G} → ((i : ℕ) → YM.MergeProof.East.Vane C i) → ℕ → ℕ :=
fun {G} {C} V i => YM.Trace.Terrace.summit C.path.levels (V i).k
def YM.Trace.Terrace.crown : {G : YM.Gauge} →
  {C : YM.Family G} → {S : YM.Table C.book} → YM.Trace.Terrace.Arch C → YM.Climb.Scaling S → (ℕ → ℕ) → ℕ → ℕ → ℝ :=
fun {G} {C} {S} Z X Q d i => Z.β (Q i) * X.r i ^ d
def YM.Trace.Shelves.Hero : {G : YM.Gauge} →
  {C : YM.Family G} →
    {S : YM.Table C.book} →
      YM.Climb.Scaling S →
        ((i : ℕ) → YM.MergeProof.East.Vane C i) →
          YM.Trace.Terrace.Arch C → (d : ℕ) → ℕ → S.Field d →ₗ[ℂ] (YM.Cells.standard C).Field d :=
fun {G} {C} {S} J V Z d i => YM.Trace.Terrace.crown Z J (YM.Trace.Terrace.Stern V) d i • ↑(LinearEquiv.symm (J.U i d))
def YM.Trace.Shelves.Phase4 : {G : YM.Gauge} →
  {C : YM.Family G} →
    {S : YM.Table C.book} →
      YM.Climb.Scaling S →
        ((i : ℕ) → YM.MergeProof.East.Vane C i) →
          YM.Trace.Terrace.Arch C → ℕ → S.Stress →ₗ[ℝ] (YM.Cells.standard C).Stress :=
fun {G} {C} {S} X V Z k =>
  { toFun := fun f i j => (YM.Trace.Shelves.Hero X V Z 4 k) (f i j), map_add' := ⋯, map_smul' := ⋯ }
def YM.Trace.Terrace.Moment4 : {G : YM.Gauge} →
  {C : YM.Family G} →
    {S : YM.Table C.book} →
      YM.Trace.Terrace.Arch C →
        YM.Climb.Scaling S →
          ((i : ℕ) → YM.MergeProof.East.Vane C i) → ℕ → C.label 4 →L[ℂ] (YM.Cells.standard C).Field 4 :=
fun {G} {C} {S} Z X V i =>
  LinearMap.toContinuousLinearMap
    (↑(LinearEquiv.symm (X.U i 4)) ∘ₗ
      YM.Next.UVStress.centering S 4 ∘ₗ
        YM.Trace.Terrace.Vault S Z 4 (YM.Trace.Terrace.Stern V i)
          (YM.Trace.Terrace.crown Z X (YM.Trace.Terrace.Stern V) 4 i))
@YM.Trace.Terrace.unveil : ∀ {G : YM.Gauge} {C : YM.Family G} {F : YM.Extraction.Order} {𝓛 : Ultrafilter (ℕ × ℕ)}
  {Z : YM.Trace.Terrace.Arch C},
  YM.Trace.Terrace.steep 𝓛 Z →
    ∀ {S : YM.Table C.book} {X : YM.Climb.Scaling S} {a : (YM.Cells.standard C).Hierarchy},
      C.Makes →
        ↑𝓛 ≤ F.fuse →
          ∀ (h : S.Hierarchy),
            YM.MergeProof.East.StarPath F a X h 𝓛 →
              ∀ {V : (i : ℕ) → YM.MergeProof.East.Vane C i}
                {Y : (d : ℕ) → ℕ → (YM.Cells.standard C).Field d →L[ℂ] C.label d},
                YM.Trace.Terrace.Gondola F a X 𝓛 V Y →
                  ∀ {W : YM.Bid.Worth},
                    YM.Trace.Terrace.Sceptre C W →
                      YM.Trace.Terrace.PostT C.path.levels →
                        G.Simple →
                          ∀ {J : YM.DiffPlan S} {P : YM.DiffPlan (YM.Cells.standard C)},
                            J.Derivatives S →
                              P.Derivatives (YM.Cells.standard C) →
                                Filter.Tendsto (YM.Trace.Terrace.Moment4 Z X V) Filter.atTop
                                  (nhds (YM.Trace.Terrace.Hill4 C))
@YM.Trace.Shelves.chartB : ∀ {G : YM.Gauge} {C : YM.Family G},
  C.Makes →
    G.Simple →
      ∀ {W : YM.Bid.Worth} {u ψ φ δ : ℕ → ℝ} {r : ℕ → ℕ}
        {D : (N p i : ℕ) → i < N → YM.MergeProof.GaugeDoor (C.path.rep N p (i + 1)) (C.path.rep N p i)},
        YM.MergeProof.Scrim C W u ψ φ δ (YM.PhysicalNext.Repeat.Legato.Bandage.fly C.path.levels) r D →
          ∀ {F : YM.Extraction.Order} {𝓛 : Ultrafilter (ℕ × ℕ)},
            ↑𝓛 ≤ F.fuse →
              ∀ {t : YM.Trace.Margin.Tickets C},
                YM.Trace.Margin.Grant C (↑𝓛) t →
                  ∀ {Z : YM.Trace.Terrace.Arch C},
                    YM.Trace.Terrace.steep 𝓛 Z →
                      ∀ {S : YM.Table C.book} {J : YM.Climb.Scaling S} {H : (YM.Cells.standard C).Hierarchy}
                        {V : (i : ℕ) → YM.MergeProof.East.Vane C i}
                        {Y : (d : ℕ) → ℕ → (YM.Cells.standard C).Field d →L[ℂ] C.label d},
                        YM.Trace.Terrace.Gondola F H J 𝓛 V Y →
                          S.Hierarchy →
                            ∀ (k j : ℕ),
                              YM.Trace.Terrace.Stern V j = k →
                                ∀ (X : YM.Trace.Slate.PaceBook C),
                                  C.ref 4 ≤ k →
                                    (YM.Trace.Shelves.Phase4 J V Z j) (YM.Trace.Shelves.baron S X k) = fun a b =>
                                      YM.Trace.Shelves.inter
                                        (fun i j' =>
                                          (YM.Trace.Terrace.Moment4 Z J V j) (YM.Trace.Slate.Shine4 Z X k i j'))
                                        a b
@YM.Trace.Shelves.nearing_h : ∀ {G : YM.Gauge} {C : YM.Family G},
  C.Makes →
    G.Simple →
      ∀ {W : YM.Bid.Worth} {u ψ φ δ : ℕ → ℝ} {r : ℕ → ℕ}
        {D : (N p i : ℕ) → i < N → YM.MergeProof.GaugeDoor (C.path.rep N p (i + 1)) (C.path.rep N p i)},
        YM.MergeProof.Scrim C W u ψ φ δ (YM.PhysicalNext.Repeat.Legato.Bandage.fly C.path.levels) r D →
          ∀ {F : YM.Extraction.Order} {𝓛 : Ultrafilter (ℕ × ℕ)},
            ↑𝓛 ≤ F.fuse →
              ∀ {t : YM.Trace.Margin.Tickets C},
                YM.Trace.Margin.Grant C (↑𝓛) t →
                  ∀ {Z : YM.Trace.Terrace.Arch C},
                    YM.Trace.Terrace.steep 𝓛 Z →
                      ∀ {S : YM.Table C.book} {J : YM.Climb.Scaling S} {H : (YM.Cells.standard C).Hierarchy}
                        {V : (i : ℕ) → YM.MergeProof.East.Vane C i}
                        {Y : (d : ℕ) → ℕ → (YM.Cells.standard C).Field d →L[ℂ] C.label d},
                        YM.Trace.Terrace.Gondola F H J 𝓛 V Y →
                          S.Hierarchy →
                            ∀ {B : YM.Trace.Slate.Bend} {P' : YM.Trace.Slate.PaceBook C},
                              YM.Trace.Slate.Rod t B (↑𝓛) P' →
                                Filter.Tendsto (YM.Trace.Terrace.Moment4 Z J V) Filter.atTop
                                    (nhds (YM.Trace.Terrace.Hill4 C)) →
                                  Filter.Tendsto
                                    (fun k =>
                                      (YM.Trace.Shelves.Phase4 J V Z k)
                                        (YM.Trace.Shelves.baron S P' (YM.Trace.Terrace.Stern V k)))
                                    Filter.atTop (nhds (YM.Trace.Shelves.materialB C B))
@YM.Trace.Shelves.muteP : ∀ {G : YM.Gauge} {C : YM.Family G},
  C.Makes →
    G.Simple →
      YM.Trace.Terrace.PostT C.path.levels →
        YM.Stock.Tabs C.path.levels →
          ∀ {W : YM.Bid.Worth} {u ψ φ δ : ℕ → ℝ} {r : ℕ → ℕ}
            {D : (N p i : ℕ) → i < N → YM.MergeProof.GaugeDoor (C.path.rep N p (i + 1)) (C.path.rep N p i)},
            YM.MergeProof.Scrim C W u ψ φ δ (YM.PhysicalNext.Repeat.Legato.Bandage.fly C.path.levels) r D →
              YM.Trace.Terrace.Sceptre C W →
                YM.Trace.Terrace.supportQ C.path.levels →
                  ∀ {F : YM.Extraction.Order} {𝓛 : Ultrafilter (ℕ × ℕ)},
                    ↑𝓛 ≤ F.fuse →
                      ∀ {t : YM.Trace.Margin.Tickets C},
                        YM.Trace.Margin.Grant C (↑𝓛) t →
                          ∀ {Z : YM.Trace.Terrace.Arch C},
                            YM.Trace.Terrace.steep 𝓛 Z →
                              ∀ {S : YM.Table C.book} {J : YM.Climb.Scaling S} {H : (YM.Cells.standard C).Hierarchy}
                                {V : (i : ℕ) → YM.MergeProof.East.Vane C i}
                                {Y : (d : ℕ) → ℕ → (YM.Cells.standard C).Field d →L[ℂ] C.label d},
                                YM.Trace.Terrace.Gondola F H J 𝓛 V Y →
                                  S.Hierarchy →
                                    F.PointLimits C S →
                                      ∀ {B : YM.Trace.Slate.Bend} {P' : YM.Trace.Slate.PaceBook C},
                                        YM.Trace.Slate.Rod t B (↑𝓛) P' →
                                          Filter.Tendsto (YM.Trace.Terrace.Moment4 Z J V) Filter.atTop
                                              (nhds (YM.Trace.Terrace.Hill4 C)) →
                                            YM.Cells.CellHyp C F →
                                              ∀ (p : ℕ),
                                                B ≠ some true →
                                                  Filter.Tendsto
                                                    (fun i =>
                                                      C.path.levels.clock.hatBeta (YM.Trace.Terrace.Stern V i) ^ p •
                                                        ∑ a,
                                                          (YM.Trace.Shelves.Phase4 J V Z i)
                                                            (YM.Trace.Shelves.baron S P' (YM.Trace.Terrace.Stern V i)) a
                                                            a)
                                                    Filter.atTop (nhds 0)
@YM.Trace.Terrace.gamut : ∀ {G : YM.Gauge} {C : YM.Family G} {F : YM.Extraction.Order} {𝓛 : Ultrafilter (ℕ × ℕ)},
  ↑𝓛 ≤ F.fuse →
    C.Makes →
      ∀ {Z : YM.Trace.Terrace.Arch C},
        YM.Trace.Terrace.steep 𝓛 Z →
          G.Simple → Filter.Tendsto (fun i => Z.β i / C.path.levels.clock.hatBeta i) Filter.atTop (nhds 1)
@YM.Trace.Terrace.Barry : ∀ {G : YM.Gauge} {C : YM.Family G} {F : YM.Extraction.Order} {𝓛 : Ultrafilter (ℕ × ℕ)}
  {Z : YM.Trace.Terrace.Arch C},
